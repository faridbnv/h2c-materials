{
  "name": "h2c-fdm-material-selector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-contained FDM material selection tool for the Bambu Lab H2C",
  "scripts": {
    "build": "npm --prefix build run build",
    "validate": "npm --prefix build run validate",
    "test": "node --test test/*.test.js",
    "pretest": "node scripts/ensure-db.mjs",
    "preaudit:data": "npm run build",
    "audit:data": "node scripts/audit-data.mjs",
    "data:fmt": "node scripts/data/fmt.mjs",
    "data:check": "node scripts/data/check.mjs",
    "data:new-id": "node scripts/data/new-id.mjs",
    "data:diff": "node scripts/data/diff.mjs",
    "trace": "node scripts/trace.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "verify": "node scripts/data/fmt.mjs --check && node scripts/data/check.mjs && node scripts/data/lint.mjs && node scripts/docs-rules.mjs --check && node scripts/docs-dictionary.mjs --check && npm test && node scripts/audit-data.mjs && node scripts/snapshot.mjs --check",
    "data:export-xlsx": "node scripts/data/export-xlsx.mjs",
    "migration:verify": "node scripts/migrate/verify-migration.mjs",
    "migration:ledger": "node scripts/migrate/transfer-ledger.mjs",
    "data:lint": "node scripts/data/lint.mjs",
    "docs:rules": "node scripts/docs-rules.mjs",
    "audit:sources": "node scripts/audit/source-completeness.mjs",
    "data:new": "node scripts/data/new.mjs",
    "data:retire": "node scripts/data/retire.mjs",
    "docs:dictionary": "node scripts/docs-dictionary.mjs",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "devDependencies": {
    "pdfjs-dist": "4.10.38"
  }
}
