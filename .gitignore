node_modules/
dist/
.DS_Store
*.log

# Personal editor state. The workspace file points at a wiki folder outside this
# repository, so it only resolves on the machine it was written on.
*.code-workspace

# Python bytecode from the historical workbook edit scripts in docs/audits/.
__pycache__/

# Local output of `npm run audit:data`. A named audit archives its own copy under docs/audits/.
build/reports/data-audit/

# Local output of `npm run audit:profile-marks`: where a print-profile error could hide on a cached sheet.
build/reports/profile-marks/


# Documents fetched by `npm run audit:sources`; each is checked against its SHA-256 in sources.csv.
.cache/

# A save of the data tables in progress (scripts/data/table-io.mjs). Left only by a save that stopped; the next
# openTables or `npm run data:fmt` finishes it, and `npm run data:check` fails until then.
data/.save/
data/.save-journal.json

# Owner-supplied source documents staged for a migration; cached under .cache/sources by SourceID.
temp_Fillaments Docs/

# Owner archives of maker document libraries, staged into .cache/sources by ingest:fetch --stage (R084).
_temp FormFutura Filaments/
_temp iSANMATE/

# Local secrets and scratch: a key or a working note never enters the repository.
.env*
/private/

# Local output of `npm run scale`: the 2x timings scripts/scale-budget.mjs judges (D131).
build/reports/scale.json

# Local output of the check-round-3 audits (scripts/audit/table-detectors.mjs, duplicates.mjs, leverage.mjs); re-derive with the commands in AGENTS.md.
build/reports/table-detectors/
build/reports/duplicates/
build/reports/leverage/
