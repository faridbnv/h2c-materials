      "date": "2026-09-19"
    },
    {
      "row": "m09",
      "code": "MEAS-PHYSICS-ORDER",
      "field": "Normalized value",
      "reason": "The sheet measures its Vicat point under 5 kg (ISO 306, the B load) and its glass transition by DSC at 10 °C/min. A B-load Vicat sits below the A-load one and can sit below the glass transition; Silk PLA+ Four-Color publishes 60.9 °C against 54 °C, which is what those two methods give on one material rather than a contradiction.",
      "by": "claude-opus-5",
      "date": "2026-09-19"
    }
  ]
