{
  "$comment": "Contract for data/tables/reference.csv. Checked by build/src/schema.js.",
  "title": "Generic reference envelopes",
  "description": "Uncited bulk and molded min/max envelopes from a general engineering reference, drawn on Ashby charts for scale only.",
  "primaryKey": "Name",
  "fields": [
