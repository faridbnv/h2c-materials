{
  "$comment": "Contract for data/tables/prices.csv. Checked by build/src/schema.js.",
  "title": "Prices",
  "description": "One row per market observation of one SKU on one access date: a Canadian listing in CAD, or a foreign one in its own currency, which prices a product that has no Canadian listing and is compared at the Bank of Canada rate in force (D113).",
  "primaryKey": "PriceID",
  "fields": [
    {
      "name": "PriceID",
      "type": "string",
      "role": "key",
      "description": "Stable price observation identifier. The prefix is historical: every listing has it, whatever its market.",
      "constraints": {
        "required": true,
        "pattern": "^CA\\d{4}$",
        "unique": true
      }
    },
    {
      "name": "MaterialID",
      "type": "string",
      "role": "canonical",
      "description": "Material the SKU belongs to.",
      "reference": {
        "table": "materials",
        "field": "MaterialID"
      },
      "constraints": {
        "required": true
      }
    },
    {
      "name": "GradeID",
      "type": "string",
      "role": "canonical",
      "description": "Exact grade sold.",
      "reference": {
        "table": "grades",
        "field": "GradeID"
      },
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Retailer",
      "type": "string",
      "role": "raw",
      "description": "Retailer.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Variant / SKU",
      "type": "string",
      "role": "raw",
      "description": "Variant or SKU as listed.",
      "constraints": {
        "required": true,
        "unique": false
      }
    },
    {
      "name": "Packaging",
      "type": "string",
      "role": "raw",
      "description": "Spool or refill.",
      "vocabulary": "packaging",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Net mass kg",
      "type": "number",
      "role": "raw",
      "description": "Net filament mass.",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "List price",
      "type": "number",
      "role": "raw",
      "description": "Regular list price, in the listing's currency, as the page printed it (including any VAT it states).",
      "missing": [
        "Not published"
      ],
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "Sale price",
      "type": "number",
      "role": "raw",
      "description": "Sale price when on sale, in the listing's currency.",
      "missing": [
        "Not applicable"
      ],
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "Stock",
      "type": "string",
      "role": "raw",
      "description": "Stock state at access.",
      "vocabulary": "stock",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Eligible for median",
      "type": "boolean",
      "role": "editorial",
      "description": "Whether the observation may enter a median.",
      "trueValues": [
        "TRUE"
      ],
      "falseValues": [
        "FALSE"
      ],
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Headline sample",
      "type": "boolean",
      "role": "editorial",
      "description": "Whether the observation is in the headline median.",
      "trueValues": [
        "TRUE"
      ],
      "falseValues": [
        "FALSE"
      ],
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Displayed price",
      "type": "number",
      "role": "raw",
      "description": "Price displayed at access, in the listing's currency.",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "Currency",
      "type": "string",
      "role": "raw",
      "description": "Currency the page prints the prices in (ISO 4217). A Canadian listing is in CAD.",
      "vocabulary": "currencies",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Market",
      "type": "string",
      "role": "raw",
      "description": "Where the listing sells; schema/vocab/markets.csv declares which markets are Canadian. Only a Canadian listing makes a product listed or buyable in Canada.",
      "constraints": {
        "required": true
      },
      "vocabulary": "markets"
    },
    {
      "name": "Tax / shipping",
      "type": "string",
      "role": "raw",
      "description": "Tax and shipping basis.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "VAT included %",
      "type": "number",
      "role": "raw",
      "description": "The VAT rate the page states its prices include. Not applicable: the price is before tax. Not published: it includes VAT at a rate the page does not state, so it cannot be compared.",
      "missing": [
        "Not applicable",
        "Not published"
      ],
      "constraints": {
        "required": true,
        "minimum": 0,
        "maximum": 30
      }
    },
    {
      "name": "Regular price basis",
      "type": "string",
      "role": "editorial",
      "description": "Why the regular price is regular; \"Quarantined\" excludes the row.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Quarantined",
      "type": "boolean",
      "role": "canonical",
      "description": "A listing kept only as an audit trail (a wrong product, a duplicate): it backs no headline, buy link or stock claim. The Regular price basis says why.",
      "trueValues": [
        "TRUE"
      ],
      "falseValues": [
        "FALSE"
      ],
      "constraints": {
        "required": true
      }
    },
    {
      "name": "URL",
      "type": "string",
      "role": "raw",
      "description": "Listing URL.",
      "constraints": {
        "required": true,
        "pattern": "^https?://"
      }
    },
    {
      "name": "SourceID",
      "type": "string",
      "role": "canonical",
      "description": "Catalogue source.",
      "reference": {
        "table": "sources",
        "field": "SourceID"
      },
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Access date",
      "type": "date",
      "role": "raw",
      "description": "Date the listing was read.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Notes",
      "type": "string",
      "role": "prose",
      "description": "Notes.",
      "constraints": {
        "required": true
      }
    }
  ]
}
