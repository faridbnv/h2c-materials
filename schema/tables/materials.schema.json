{
  "$comment": "Contract for data/tables/materials.csv. Checked by build/src/schema.js.",
  "title": "Materials",
  "description": "One row per selection identity: a filament material, a family entry, or an excluded material. Headline values are selected in headlines.csv and read from the measurements they cite.",
  "primaryKey": "MaterialID",
  "fields": [
    {
      "name": "MaterialID",
      "type": "string",
      "role": "key",
      "description": "Stable material identifier. Never reused.",
      "constraints": {
        "required": true,
        "pattern": "^M\\d{3}$",
        "unique": true
      }
    },
    {
      "name": "Original name",
      "type": "string",
      "role": "canonical",
      "description": "Name as it appears in the canonical master list.",
      "constraints": {
        "required": true,
        "unique": true
      }
    },
    {
      "name": "Family",
      "type": "string",
      "role": "canonical",
      "description": "Navigation family.",
      "vocabulary": "families",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "H2C status",
      "type": "string",
      "role": "canonical",
      "description": "How the material relates to the Bambu Lab H2C.",
      "vocabulary": "h2c-status",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Representative grade",
      "type": "string",
      "role": "editorial",
      "description": "The exact commercial grade whose measurements back the headlines.",
      "missing": [
        "Not published"
      ],
      "reference": {
        "table": "grades",
        "field": "GradeID"
      },
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Measurement conditions",
      "type": "string",
      "role": "prose",
      "description": "Moisture and post-processing conditions behind the headlines.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Price basis",
      "type": "string",
      "role": "prose",
      "description": "How the headline price was formed.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Best uses",
      "type": "string",
      "role": "prose",
      "description": "Documented best uses.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Limitations",
      "type": "string",
      "role": "prose",
      "description": "Documented limitations.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Full name",
      "type": "string",
      "role": "canonical",
      "description": "Expanded polymer name.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Original category",
      "type": "string",
      "role": "canonical",
      "description": "Category from the canonical master list.",
      "vocabulary": "families",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Scope",
      "type": "string",
      "role": "canonical",
      "description": "Whether the row is a candidate, a family entry, or excluded.",
      "vocabulary": "scopes",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Abbreviation",
      "type": "string",
      "role": "canonical",
      "description": "Short display name.",
      "constraints": {
        "required": true,
        "unique": true
      }
    },
    {
      "name": "Normalized name",
      "type": "string",
      "role": "canonical",
      "description": "Search-normalized name.",
      "constraints": {
        "required": true,
        "unique": true
      }
    },
    {
      "name": "Base polymer",
      "type": "string",
      "role": "canonical",
      "description": "Base polymer identity used by the estimate model.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Modifier / filler",
      "type": "string",
      "role": "canonical",
      "description": "Reinforcement or formulation modifier.",
      "vocabulary": "modifiers",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Role",
      "type": "string",
      "role": "canonical",
      "description": "Structural material or support/interface material.",
      "vocabulary": "material-roles",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Identity source",
      "type": "string",
      "role": "canonical",
      "description": "Source of the material identity.",
      "reference": {
        "table": "sources",
        "field": "SourceID"
      },
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Identity notes",
      "type": "string",
      "role": "prose",
      "description": "Notes on identity decisions.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Headline basis",
      "type": "string",
      "role": "prose",
      "description": "What the headline values represent.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Impact / toughness",
      "type": "string",
      "role": "prose",
      "description": "Impact and toughness note.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Fatigue / creep",
      "type": "string",
      "role": "prose",
      "description": "Fatigue and creep note.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "Printability rating 1–5",
      "type": "number",
      "role": "editorial",
      "description": "Analyst printability rating on rubric R-PRINT.",
      "missing": [
        "Not published"
      ],
      "constraints": {
        "required": true,
        "minimum": 1,
        "maximum": 5
      }
    },
    {
      "name": "Printability rubric",
      "type": "string",
      "role": "canonical",
      "description": "Rubric the printability rating uses.",
      "vocabulary": "rubrics",
      "constraints": {
        "required": true
      }
    }
  ]
}
