{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdynamics.ca/h2c-materials/reference.schema.json",
  "title": "Generic reference envelopes (dist/reference.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "materials"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "categories",
        "properties",
        "axisEquivalence",
        "defaultSelection",
        "caveat"
      ],
      "properties": {
        "count": {
          "type": "integer"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "unit",
              "offset"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "offset": {
                "type": "number"
              }
            }
          }
        },
        "axisEquivalence": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "defaultSelection": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caveat": {
          "type": "string"
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "isReference",
          "properties",
          "default"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REF-"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "isReference": {
            "const": true
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max",
                    "unit"
                  ],
                  "properties": {
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "default": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
