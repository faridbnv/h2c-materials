{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdynamics.ca/h2c-materials/db.schema.json",
  "title": "H2C Material Selector runtime database (dist/db.json)",
  "description": "The contract between the build and the offline application. build/src/contract.js validates every build against it; a renamed, removed, retyped or unexpected field in a record fails the build. Nested analysis objects (print summaries, gates, estimates, model diagnostics) are typed at their top level only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "materials",
    "grades",
    "measurements",
    "profiles",
    "evidence",
    "prices",
    "sources",
    "coverage",
    "method",
    "polymers",
    "registry"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "snapshot",
        "build",
        "pricesSampled",
        "h2cBaseline",
        "counts",
        "environmentCategories",
        "chamberEstimates",
        "headlineCoverage",
        "consistency"
      ],
      "properties": {
        "snapshot": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "build": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "pricesSampled": {
          "type": [
            "string",
            "null"
          ]
        },
        "h2cBaseline": {
          "type": "object"
        },
        "counts": {
          "type": "object"
        },
        "environmentCategories": {
          "type": "object"
        },
        "estimateCoverage": {
          "type": "object"
        },
        "estimateModel": {
          "type": "object"
        },
        "chamberEstimates": {
          "type": "object"
        },
        "printEstimates": {
          "type": "object"
        },
        "headlineCoverage": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "consistency": {
          "type": "object"
        },
        "estimateTally": {
          "type": "object"
        }
      },
      "description": "estimateCoverage, estimateModel, printEstimates and estimateTally are written by the estimate stage and absent from a core build (--no-estimates)."
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "grades": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "materialId",
          "manufacturer",
          "product",
          "formulationKey",
          "composition",
          "colourCaveat",
          "availability",
          "certifications",
          "rationale",
          "sourceId",
          "locator",
          "diameters",
          "retired",
          "variant"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G\\d{3}-(\\d{2,3}|R\\d+)$"
          },
          "materialId": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "formulationKey": {
            "type": "string"
          },
          "composition": {
            "type": "string"
          },
          "colourCaveat": {
            "type": "string"
          },
          "availability": {
            "type": "string"
          },
          "certifications": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "diameters": {
            "type": "string"
          },
          "retired": {
            "type": "boolean"
          },
          "variant": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimate": {
            "type": "object",
            "description": "The grade's own estimate per headline (D81): added by the estimate stage, absent from the core build. It decides nothing.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strength",
                "precision",
                "unit",
                "centre",
                "lo",
                "hi",
                "plausible",
                "ownShare",
                "evidence",
                "basis"
              ],
              "properties": {
                "strength": {
                  "enum": [
                    "this-grade",
                    "this-material",
                    "family"
                  ]
                },
                "precision": {
                  "enum": [
                    "good",
                    "fair",
                    "poor"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "centre": {
                  "type": "number"
                },
                "lo": {
                  "type": "number"
                },
                "hi": {
                  "type": "number"
                },
                "plausible": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "lo",
                    "hi"
                  ],
                  "properties": {
                    "lo": {
                      "type": "number"
                    },
                    "hi": {
                      "type": "number"
                    }
                  }
                },
                "ownShare": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "measurementIds",
                      "converted",
                      "conflict"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "measurementIds": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "converted": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "conflict": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "basis": {
                  "type": "string"
                },
                "sharedWith": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "materialId",
          "gradeId",
          "property",
          "value",
          "unit",
          "interval",
          "uncertainty",
          "operator",
          "dataStatus",
          "corrected",
          "implausible",
          "qualitative",
          "quarantined",
          "numeric",
          "specimenType",
          "specimenForm",
          "direction",
          "directionText",
          "moisture",
          "moistureState",
          "postProcessing",
          "postProcessingState",
          "anneal",
          "testTemperature",
          "standardText",
          "standards",
          "notch",
          "printParameters",
          "sourceId",
          "locator",
          "notes",
          "raw"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^V\\d{6}$"
          },
          "materialId": {
            "type": "string"
          },
          "gradeId": {
            "type": "string"
          },
          "property": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "interval": {
            "anyOf": [
              {
                "$ref": "#/$defs/interval"
              },
              {
                "type": "null"
              }
            ]
          },
          "uncertainty": {
            "type": [
              "number",
              "null"
            ]
          },
          "operator": {
            "type": [
              "string",
              "null"
            ]
          },
          "dataStatus": {
            "type": "string"
          },
          "corrected": {
            "type": "boolean"
          },
          "implausible": {
            "type": "boolean"
          },
          "qualitative": {
            "type": "boolean"
          },
          "quarantined": {
            "type": "boolean"
          },
          "numeric": {
            "type": "boolean"
          },
          "specimenType": {
            "type": "string"
          },
          "specimenForm": {
            "enum": [
              "printed",
              "not-stated",
              "moulded",
              "film",
              "filament"
            ]
          },
          "direction": {
            "type": "string"
          },
          "directionText": {
            "type": "string"
          },
          "moisture": {
            "type": "string"
          },
          "moistureState": {
            "enum": [
              "dry",
              "conditioned",
              "not-stated"
            ]
          },
          "postProcessing": {
            "type": "string"
          },
          "postProcessingState": {
            "enum": [
              "as-printed",
              "annealed",
              "not-stated"
            ]
          },
          "anneal": {
            "description": "The annealing schedule (Anneal °C, Anneal h), or null when not annealed.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tempC",
                  "hours"
                ],
                "properties": {
                  "tempC": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "hours": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            ]
          },
          "testTemperature": {
            "type": "string"
          },
          "standardText": {
            "type": "string"
          },
          "standards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notch": {
            "type": "string"
          },
          "printParameters": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "raw": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              }
            }
          },
          "thermal": {
            "type": "object"
          },
          "fatigue": {
            "type": "object"
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "materialId",
          "gradeId",
          "profile",
          "nozzle",
          "bed",
          "chamber",
          "gates",
          "enclosure",
          "enclosureState",
          "plate",
          "nozzleMaterial",
          "nozzleDiameter",
          "abrasion",
          "drying",
          "notes",
          "routing",
          "supportPairing",
          "failureModes",
          "sourceId",
          "h2cSourceId",
          "locator",
          "retired"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P\\d{4}$"
          },
          "materialId": {
            "type": "string"
          },
          "gradeId": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "nozzle": {
            "type": "object"
          },
          "bed": {
            "type": "object"
          },
          "chamber": {
            "type": "object"
          },
          "gates": {
            "type": "object"
          },
          "enclosure": {
            "type": "string"
          },
          "enclosureState": {
            "type": "string"
          },
          "plate": {
            "type": "string"
          },
          "nozzleMaterial": {
            "type": "string"
          },
          "nozzleDiameter": {
            "type": "object"
          },
          "abrasion": {
            "type": "object"
          },
          "drying": {
            "type": "object"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "topic",
                "text"
              ],
              "properties": {
                "topic": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "routing": {
            "type": "object"
          },
          "supportPairing": {
            "type": "string"
          },
          "failureModes": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "h2cSourceId": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "retired": {
            "type": "boolean"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "materialId",
          "gradeId",
          "domain",
          "topic",
          "category",
          "categoryLabel",
          "filterable",
          "strength",
          "agent",
          "verdict",
          "finding",
          "qualified",
          "vague",
          "exposure",
          "rating",
          "rubricId",
          "evidenceType",
          "sourceId",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q\\d{5}$"
          },
          "materialId": {
            "type": "string"
          },
          "gradeId": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "categoryLabel": {
            "type": "string"
          },
          "filterable": {
            "type": "boolean"
          },
          "strength": {
            "type": [
              "string",
              "null"
            ]
          },
          "agent": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "qualified": {
            "type": "boolean"
          },
          "vague": {
            "type": "boolean"
          },
          "exposure": {
            "type": "string"
          },
          "rating": {
            "type": [
              "number",
              "null"
            ]
          },
          "rubricId": {
            "type": "string"
          },
          "evidenceType": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          }
        }
      }
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "materialId",
          "gradeId",
          "retailer",
          "variant",
          "packaging",
          "netMassKg",
          "listPrice",
          "salePrice",
          "regularPerKg",
          "stock",
          "eligibleForMedian",
          "headlineSample",
          "displayedPrice",
          "currency",
          "market",
          "taxShipping",
          "basis",
          "url",
          "sourceId",
          "accessDate",
          "notes",
          "quarantined"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CA\\d{4}$"
          },
          "materialId": {
            "type": "string"
          },
          "gradeId": {
            "type": "string"
          },
          "retailer": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "packaging": {
            "type": "string"
          },
          "netMassKg": {
            "type": "number"
          },
          "listPrice": {
            "type": [
              "number",
              "null"
            ]
          },
          "salePrice": {
            "type": [
              "number",
              "null"
            ]
          },
          "regularPerKg": {
            "type": [
              "number",
              "null"
            ]
          },
          "stock": {
            "type": "string"
          },
          "eligibleForMedian": {
            "type": "boolean"
          },
          "headlineSample": {
            "type": "boolean"
          },
          "displayedPrice": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "taxShipping": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "accessDate": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "quarantined": {
            "type": "boolean"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "publisher",
          "title",
          "revision",
          "publicationDate",
          "accessDate",
          "sourceClass",
          "sourceNote",
          "url",
          "locator",
          "applicableGrades",
          "accessState",
          "accessNote",
          "sha256",
          "citationRole"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "publicationDate": {
            "type": "string"
          },
          "accessDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "sourceClass": {
            "type": "string"
          },
          "sourceNote": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "applicableGrades": {
            "type": "string"
          },
          "accessState": {
            "enum": [
              "retrieved",
              "retrieved-copy",
              "read-only",
              "not-retrieved"
            ]
          },
          "accessNote": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "citationRole": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "materialId",
          "domain",
          "status",
          "manufacturerCount",
          "finding",
          "derived"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(C\\d{5}|derived-M\\d{3}-[a-z0-9-]+)$"
          },
          "materialId": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "manufacturerCount": {
            "type": [
              "number",
              "null"
            ]
          },
          "finding": {
            "type": "string"
          },
          "derived": {
            "type": "boolean"
          }
        }
      }
    },
    "method": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section",
          "topic",
          "rule"
        ],
        "properties": {
          "section": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          }
        }
      }
    },
    "polymers": {
      "type": "array",
      "description": "The polymer identities the estimate stage knows (data/tables/polymers.csv).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "morphology",
          "meltingPointC",
          "asPrinted",
          "waterUptake",
          "neatDensity",
          "sourceId",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "morphology": {
            "enum": [
              "amorphous",
              "semicrystalline",
              "elastomer"
            ]
          },
          "meltingPointC": {
            "type": [
              "number",
              "null"
            ]
          },
          "asPrinted": {
            "type": [
              "string",
              "null"
            ]
          },
          "waterUptake": {
            "enum": [
              "high",
              "low",
              null
            ]
          },
          "neatDensity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "min",
                  "max"
                ],
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "basis": {
            "type": "string"
          }
        }
      }
    },
    "polymerEnvironment": {
      "type": "array",
      "description": "The published environmental behaviour of base polymers (data/tables/polymer_environment.csv), one row per polymer, category and agent. Present only when the table has rows (D64).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "polymerId",
          "category",
          "categoryLabel",
          "agent",
          "conditions",
          "verdict",
          "screens",
          "finding",
          "sourceId",
          "locator",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PB\\d{5}$"
          },
          "polymerId": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "categoryLabel": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "conditions": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict": {
            "type": "string"
          },
          "screens": {
            "type": "boolean"
          },
          "finding": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "polymerEvidence": {
      "type": "array",
      "description": "Inferred environment records: for each candidate material and each category where it has no record of its own, its base polymer's published behaviour, with the category verdict derived by D64's rule. Shown, may screen under inference, never passes. Present only when polymerEnvironment is.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "materialId",
          "polymerId",
          "category",
          "categoryLabel",
          "verdict",
          "screens",
          "evidenceType",
          "inferred",
          "agents",
          "sourceIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
