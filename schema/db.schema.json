    "headlineMeasured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known",
        "value",
        "unit",
        "origin",
        "verified",
        "measurementId",
        "gradeId",
        "sourceId",
        "direction",
        "specimenType",
        "moisture",
        "postProcessing",
        "interval",
        "uncertainty"
