          "const": true
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "measurementId": {
          "type": "string",
          "pattern": "^V\\d{6}$"
        },
        "gradeId": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "specimenType": {
          "type": "string"
        },
        "moisture": {
          "type": "string"
        },
        "postProcessing": {
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "uncertainty": {
          "type": [
            "number",
            "null"
          ]
        },
        "loadStated": {
          "type": "boolean"
        },
        "loadMPa": {
          "type": [
            "number",
            "null"
          ]
        },
        "standard": {
          "type": [
            "string",
            "null"
          ]
        },
        "caveat": {
          "type": "string"
