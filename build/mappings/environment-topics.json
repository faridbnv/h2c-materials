{
  "_comment": [
    "Maps the Use & durability sheet's 73 Topic values onto canonical categories.",
    "The sheet carries two overlapping source vocabularies for the same chemistry:",
    "'Resistance to Acid' from one family of TDS documents and 'Effect of weak acids' /",
    "'Effect of strong acids' from another. They merge to one category but keep their strength",
    "qualifier, because a source that distinguished weak from strong said more than one that did not.",
    "",
    "filterable=false marks records that are not environment evidence at all and must never back an",
    "environment criterion. 'Test specimen preparation' is the large case: 35 rows of measurement",
    "metadata that happen to live in this sheet."
  ],
  "categories": {
    "acid":             { "label": "Acid resistance",            "noun": "acids",                "filterable": true },
    "alkali":           { "label": "Alkali resistance",          "noun": "alkalis",              "filterable": true },
    "organic-solvent":  { "label": "Organic solvent resistance", "noun": "solvents",             "filterable": true },
    "oil-grease":       { "label": "Oil and grease resistance",  "noun": "oils and grease",      "filterable": true },
    "water-solubility": { "label": "Water solubility",           "noun": "water",                "filterable": true },
    "uv-outdoor":       { "label": "UV and outdoor",             "noun": "sunlight and weather", "filterable": true },
    "moisture":         { "label": "Moisture sensitivity",       "noun": "moisture",             "filterable": true },
    "hydrolysis":       { "label": "Hydrolytic stability",       "noun": "hot water and steam",  "filterable": true },
    "flammability":     { "label": "Flammability",               "noun": "fire",                 "filterable": true },
    "food-contact":     { "label": "Food contact claims",        "noun": "food contact",         "filterable": true },
    "fatigue":          { "label": "Fatigue evidence",           "noun": "repeated loading",     "filterable": true },
    "creep":            { "label": "Creep evidence",             "noun": "sustained load",       "filterable": true },
    "application":      { "label": "Application notes",          "filterable": false },
    "print-quality":    { "label": "Print quality",              "filterable": false },
    "post-processing":  { "label": "Post-processing",            "filterable": false },
